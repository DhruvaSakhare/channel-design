# Site overrides for the DTU HPC run, as an example of what the environment
# variables in partial_diffusion/site.py are for. Copy, edit, and source it:
#
#   cp envs/dtu-hpc.env.example envs/site.env   # gitignored
#   source envs/site.env
#
# Nothing here is required. Every value has a repo-relative default, and the
# pipeline runs without any of them -- they only point at a cluster's own
# installs. Replace each <...> with the path on your system.

# Conda profile to source inside batch jobs, and the environment to activate.
# Leave both empty if the environment is already active.
export CONDA_SH="<conda-root>/etc/profile.d/conda.sh"
export PROTEIN_ENV="<conda-root>/envs/protein-design"

# Model weights. EASIEST OPTION: do not name each file -- just list the
# directories to search, and the pipeline finds them. Colon-separated.
export CKPT_SEARCH_PATH="<foundry-install>/ckpt:<rf3-install>/release/ckpt"

# Or name them individually, which overrides the search above. Only needed if
# the filenames differ from what the pipeline expects. See envs/design.md.
# export RFD3_CKPT="<weights>/rfd3_latest.ckpt"
# export MPNN_CKPT="<weights>/ligandmpnn_v_32_010_25.pt"
# export RF3_RELEASE="<rf3-install>/release"
# export RF3_CKPT="$RF3_RELEASE/ckpt/rf3_latest.pt"
#
# Nothing set, and nothing found? Either download them --
#   ./setup.sh --gpu --weights
# -- or see envs/design.md. Check what resolved with:
#   python enzyme_design/partial_diffusion/site.py

# LSF queues. `bqueues` lists what you actually have.
export PIPELINE_QUEUE="gpua100"       # GPU: RFD3, LigandMPNN, RF3
export PIPELINE_CPU_QUEUE="hpc"       # CPU: prep, scoring, CAVER

# Where runs are written. Put this on scratch, not in the repository.
export PIPELINE_WORK_ROOT="/scratch/$USER/channel-design-runs"

# CAVER, if you have one already (otherwise scripts/fetch_third_party.sh).
# export CAVER_HOME="<caver-install>"
