# Site overrides: what the environment variables in partial_diffusion/site.py
# are for. Copy, edit, and source it:
#
#   cp envs/site.env.example envs/site.env   # gitignored
#   source envs/site.env
#
# Nothing here is required to run on one GPU (run_local.py). Every value has a
# repo-relative default, and the pipeline runs without any of them -- they only
# point at a cluster's own installs. Replace each <...> with the path on your
# system.

# Conda profile to source inside batch jobs, and the environment to activate.
# Leave both empty if the environment is already active.
export CONDA_SH="<conda-root>/etc/profile.d/conda.sh"
export PROTEIN_ENV="<conda-root>/envs/protein-design"

# Model weights. Name them explicitly; the pipeline does not go looking.
# Leave these commented out to use the repo's own ckpt/ directory, which is
# where `./setup.sh --gpu --weights` puts them.
#
# RF3_RELEASE is the software TREE, not just the weights.
# export RFD3_CKPT="<foundry-install>/ckpt/rfd3_latest.ckpt"
# export MPNN_CKPT="<foundry-install>/ckpt/ligandmpnn_v_32_010_25.pt"
# export RF3_RELEASE="<rf3-install>/release"
# export RF3_CKPT="$RF3_RELEASE/ckpt/rf3_latest.pt"
#
# Do not have them anywhere? Either `./setup.sh --gpu --weights`, or see
# envs/design.md. Check what resolved, and whether it exists:
#   python enzyme_design/partial_diffusion/site.py

# LSF queues (only for 00_submit_all.py; run_local.py needs none). REQUIRED
# there -- site.py has no default, because a queue name means nothing on a
# cluster that is not yours. `bqueues` lists what you have.
export PIPELINE_QUEUE="<gpu-queue>"       # GPU: RFD3, LigandMPNN, RF3
export PIPELINE_CPU_QUEUE="<cpu-queue>"   # CPU: prep, scoring, the CAVER gate

# Where runs are written. Put this on scratch, not in the repository.
export PIPELINE_WORK_ROOT="/scratch/$USER/channel-design-runs"

# CAVER, if you have one already (otherwise scripts/fetch_third_party.sh).
# export CAVER_HOME="<caver-install>"
